# Capture output: traces, exports and the pipeline dump all land in the traced repo, next to
# wherever the capture ran. Never commit them. Anchored to this repo's root so the same names
# stay usable deeper in the tree (skills/gputrace-headless).
/gputrace/
/gputrace-*/
/pipeline-dump/
/pipeline-dump-*/
/ncu/
/gui/

# Nsight Graphics artifacts
*.ngfx-gputrace
*.xls
*.layout

# Test fixtures are the one place a .xls is authored rather than exported.
!tests/fixtures/**/*.xls

# Regenerable pipeline output: decompressed sections, extracted sampling buffers,
# histograms. 716 MiB+ per capture, rebuildable with wrpv-dump.py / pcs-*.py.
/out/

# gputrace-sampling.ps1 default work dir: decoded buffers and the per-source-line CSVs,
# rebuildable from the capture with one command.
/gputrace-sampling/

# Local research trail, deliberately unpublished: the reverse-engineering docs, NVIDIA's
# extracted .proto schemas, and two superseded research scripts. They stay on disk for the
# author; the published tree is the tool only.
/docs/
/schemas/
/verify-extract.py
/gputrace-pc2line.py

# Build products of the tools under tools/
tools/vklayer/*.obj
tools/vklayer/*.exp
tools/vklayer/*.lib
tools/vkproxy/*.obj
tools/vkproxy/*.exp
tools/vkproxy/*.lib
tools/vkproxy/vulkan-1.dll
tools/vkproxy/vulkan-1.exp
tools/vkproxy/vulkan-1.lib
tools/vkproxy/vulkan-exports.txt

# Preserved reference captures. These are the oracles every number in docs/ is checked
# against, and they are 100 MB each, so they live on disk and are referenced by path
# rather than committed. Re-create with gputrace-capture.ps1.
/captures/

# Python bytecode: regenerated on every run and machine-specific.
__pycache__/
*.pyc

# Shipped NVIDIA binaries, copied here for REA analysis. Re-obtainable from the
# install; a 20 MB DLL does not belong in the history.
WarpVizPlugin.dll
*.dll

# Editor / OS
.vscode/
.idea/
*.user
Thumbs.db
Desktop.ini
